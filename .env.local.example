# Copy to .env.local

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# NestJS API auth (generate: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret

# Expo app -> NestJS API backend URL
# Use your machine IP for physical devices, localhost for web/simulator
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# SMTP for login OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MamaTrack <no-reply@example.com>"
